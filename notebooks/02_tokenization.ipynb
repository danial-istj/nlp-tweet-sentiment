import pandas as pd
import re
from pathlib import Path
from collections import Counter
import matplotlib.pyplot as plt
import seaborn as sns

from nltk.tokenize import TweetTokenizer

# Find project root directory
ROOT = Path.cwd()

if not (ROOT / "data").exists():
    ROOT = ROOT.parent

RAW_DIR = ROOT / "data" / "raw"
PROCESSED_DIR = ROOT / "data" / "processed"

PROCESSED_DIR.mkdir(parents=True, exist_ok=True)

print("Project Directory:", ROOT)
print("Processed Directory:", PROCESSED_DIR)

# Initialize TweetTokenizer
tokenizer = TweetTokenizer(
    preserve_case=False,
    strip_handles=False
)

print("Tweet Tokenizer initialized successfully!")

# Load processed datasets

splits = ["train", "validation", "test"]

datasets = {}

for split in splits:

    input_file = PROCESSED_DIR / f"{split}_cleaned.csv"

    df = pd.read_csv(input_file)

    datasets[split] = df

    print(f"\n{split.upper()} Dataset Loaded")
    print("Total Documents:", len(df))
    print("Columns:", df.columns.tolist())

    # Display training dataset

train_df = datasets["train"]

print("Dataset Shape:", train_df.shape)

print("\nFirst 5 Records:")

display(train_df.head())

print("\nMissing Values:")

print(train_df.isnull().sum())

# Tokenization function

def tokenize_text(text):

    if pd.isna(text):
        return []

    tokens = tokenizer.tokenize(str(text))

    return tokens


print("Tokenization function created successfully!")

# Apply tokenization

for split in splits:

    df = datasets[split]

    # Use cleaned_text generated by cleaning.py
    df["tokens"] = df["cleaned_text"].apply(tokenize_text)

    # Count tokens in each tweet
    df["token_count"] = df["tokens"].apply(len)

    # Convert tokens into a single string
    df["tokenized_text"] = df["tokens"].apply(
        lambda tokens: " ".join(tokens)
    )

    print(f"\n{split.upper()} Tokenization Completed")

    print("Total Documents:", len(df))

    print("Total Tokens:", df["token_count"].sum())

    # Display tokenization examples

for i in range(5):

    print("\nExample", i + 1)

    print("Cleaned Text:")

    print(train_df["cleaned_text"].iloc[i])

    print("\nTokens:")

    print(train_df["tokens"].iloc[i])

    print("\nToken Count:")

    print(train_df["token_count"].iloc[i])

    print("-" * 60)

    # Calculate total tokens in each dataset

for split in splits:

    df = datasets[split]

    total_documents = len(df)

    total_tokens = df["token_count"].sum()

    average_tokens = df["token_count"].mean()

    print("\n", split.upper(), "STATISTICS")

    print("Total Documents:", total_documents)

    print("Total Tokens:", total_tokens)

    print("Average Tokens per Tweet:", round(average_tokens, 2))

    # Count word frequency

all_tokens = []

for tokens in train_df["tokens"]:

    all_tokens.extend(tokens)

word_frequency = Counter(all_tokens)

# Display 20 most common words

most_common_words = word_frequency.most_common(20)

frequency_df = pd.DataFrame(
    most_common_words,
    columns=["Word", "Frequency"]
)

display(frequency_df)

# Plot most frequent words

plt.figure(figsize=(12, 6))

sns.barplot(
    data=frequency_df,
    x="Frequency",
    y="Word"
)

plt.title("Top 20 Most Frequent Words in Tweets")

plt.xlabel("Frequency")

plt.ylabel("Words")

plt.tight_layout()

plt.show()

# Sentiment label distribution

label_names = {
    0: "Negative",
    1: "Neutral",
    2: "Positive"
}

label_counts = train_df["label"].value_counts().sort_index()

label_df = pd.DataFrame({
    "Sentiment": [
        label_names.get(label, str(label))
        for label in label_counts.index
    ],
    "Count": label_counts.values
})

display(label_df)

plt.figure(figsize=(8, 5))

sns.barplot(
    data=label_df,
    x="Sentiment",
    y="Count"
)

plt.title("Sentiment Distribution in Training Dataset")

plt.xlabel("Sentiment")

plt.ylabel("Number of Tweets")

plt.show()

# Save tokenized datasets

for split in splits:

    df = datasets[split]

    output_file = PROCESSED_DIR / f"{split}_tokenized.csv"

    # Save tokenized dataset
    df.to_csv(
        output_file,
        index=False,
        encoding="utf-8"
    )

    print(f"Saved: {output_file}")

print("\nAll datasets tokenized and saved successfully!")


def join_tokens(tokens):
    return " ".join(tokens)

df["tokenized_text"] = df["tokens"].apply(join_tokens)
